# Local Compose defaults only. Never reuse these database passwords in production.
DATABASE_URL=postgres://jobauto:local-development-only@127.0.0.1:55432/jobauto
# bun run setup generates a private .env with a random pepper. Do not use this placeholder.
API_KEY_PEPPER=replace-with-64-random-hex-characters
API_KEY_PEPPER_VERSION=1
APP_ORIGIN=http://127.0.0.1:5175
HOST=127.0.0.1
SERVICE_PORT=4310
PORT=4310
ENABLE_LOCAL_DEMO=false
# Populated by bun run demo:enable for the loopback-only workbench scenarios.
# DEMO_KEY_ID=
# Execution policy (deployment-controlled, never accepted from a request).
MAX_ACTIVE_INTELLIGENCE=2
IDEMPOTENCY_TTL_HOURS=24
RETENTION_DAYS=30
