{
  "openapi": "3.1.0",
  "info": {
    "title": "jobauto API",
    "version": "1.0.0",
    "description": "Implemented API for grounded job analysis, candidate matching and extractive CV tailoring on the native Cequre backend. PostgreSQL is the system of record. Runs are accepted durably and executed in-process with an atomic cross-replica claim. application_prepare, browser automation, approval/resume, webhooks and submission are not available. Scoped API keys only; no console sessions. Private responses are Cache-Control private, no-store. Unknown request properties are rejected."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4310",
      "description": "Local Cequre API"
    }
  ],
  "security": [
    {
      "clientKey": []
    }
  ],
  "tags": [
    { "name": "System" },
    { "name": "Intelligence" },
    { "name": "Runs" },
    { "name": "Artifacts" },
    { "name": "Privacy" }
  ],
  "components": {
    "securitySchemes": {
      "clientKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Bearer ja_live_<key-id>.<secret>"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "request_id"],
        "properties": {
          "data": {},
          "request_id": { "type": "string", "format": "uuid" }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error", "request_id"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "retryable", "details"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "retryable": { "type": "boolean" },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "code"],
                  "properties": {
                    "path": { "type": "string" },
                    "code": { "type": "string" }
                  }
                }
              }
            }
          },
          "request_id": { "type": "string", "format": "uuid" }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "service", "backend"],
        "properties": {
          "status": { "const": "ok" },
          "service": { "const": "jobauto-v1" },
          "backend": { "const": "cequre" }
        }
      },
      "Capabilities": {
        "type": "object",
        "additionalProperties": false,
        "required": ["api_version", "backend", "operations", "limits", "consent_purposes", "disclosure"],
        "properties": {
          "api_version": { "const": "v1" },
          "backend": { "const": "cequre" },
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operation", "status"],
              "properties": {
                "operation": {
                  "enum": ["job_analysis", "match", "cv_tailoring", "application_prepare"]
                },
                "status": { "enum": ["available", "unavailable"] }
              }
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": ["job_characters", "candidate_facts", "timeout_seconds", "request_bytes"],
            "properties": {
              "job_characters": {
                "type": "array",
                "prefixItems": [{ "type": "integer" }, { "type": "integer" }],
                "minItems": 2,
                "maxItems": 2
              },
              "candidate_facts": { "type": "integer" },
              "timeout_seconds": {
                "type": "array",
                "prefixItems": [{ "type": "integer" }, { "type": "integer" }],
                "minItems": 2,
                "maxItems": 2
              },
              "request_bytes": { "type": "integer" }
            }
          },
          "consent_purposes": {
            "type": "array",
            "items": { "enum": ["job_matching", "cv_tailoring"] }
          },
          "disclosure": { "type": "string" }
        }
      },
      "Job": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text"],
        "properties": {
          "kind": { "const": "text" },
          "text": { "type": "string", "minLength": 20, "maxLength": 30000 }
        }
      },
      "CandidateFact": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "text"],
        "properties": {
          "id": { "type": "string", "maxLength": 80 },
          "kind": {
            "enum": ["summary", "skill", "experience", "education", "certification", "project", "achievement"]
          },
          "text": { "type": "string", "maxLength": 2000 },
          "employer": { "type": "string", "maxLength": 160 },
          "title": { "type": "string", "maxLength": 160 },
          "institution": { "type": "string", "maxLength": 160 },
          "credential": { "type": "string", "maxLength": 160 },
          "start_date": { "type": "string", "format": "date" },
          "end_date": { "type": ["string", "null"], "format": "date" }
        }
      },
      "Candidate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_ref", "consent", "facts", "preferences"],
        "properties": {
          "subject_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "consent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["purpose", "granted_at"],
            "properties": {
              "purpose": { "enum": ["job_matching", "cv_tailoring"] },
              "granted_at": { "type": "string", "format": "date-time" }
            }
          },
          "facts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": { "$ref": "#/components/schemas/CandidateFact" }
          },
          "preferences": {
            "type": "object",
            "additionalProperties": false,
            "required": ["preparation_only"],
            "properties": { "preparation_only": { "const": true } }
          }
        }
      },
      "Options": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "locale": { "const": "en" },
          "timeout_seconds": { "type": "integer", "minimum": 30, "maximum": 300 }
        }
      },
      "Accepted": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "status", "replayed", "status_url"],
        "properties": {
          "run_id": { "type": "string", "format": "uuid" },
          "status": { "const": "accepted" },
          "replayed": { "type": "boolean" },
          "status_url": { "type": "string" }
        }
      },
      "Run": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "operation",
          "status",
          "phase",
          "progress",
          "version",
          "created_at",
          "started_at",
          "completed_at",
          "cancel_requested_at",
          "result",
          "error",
          "usage",
          "intervention"
        ],
        "properties": {
          "run_id": { "type": "string", "format": "uuid" },
          "operation": { "enum": ["job_analysis", "match", "cv_tailoring", "application_prepare"] },
          "status": { "enum": ["queued", "running", "completed", "failed", "cancelled"] },
          "phase": { "enum": ["prepare", "execute", "finalize"] },
          "progress": { "type": "integer", "minimum": 0, "maximum": 100 },
          "version": { "type": "integer", "minimum": 1 },
          "created_at": { "type": "string", "format": "date-time" },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "completed_at": { "type": ["string", "null"], "format": "date-time" },
          "cancel_requested_at": { "type": ["string", "null"], "format": "date-time" },
          "result": { "type": ["object", "null"], "additionalProperties": true },
          "error": { "type": ["object", "null"], "additionalProperties": true },
          "usage": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "model": { "type": ["string", "null"] },
              "prompt_version": { "type": ["string", "null"] },
              "input_tokens": { "type": ["integer", "null"] },
              "output_tokens": { "type": ["integer", "null"] },
              "estimated_cost_usd": { "type": "number" },
              "latency_ms": { "type": ["number", "null"] }
            }
          },
          "intervention": { "type": "null" }
        }
      },
      "RunEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "type", "status", "metadata", "created_at"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "type": { "type": "string" },
          "status": { "type": "string" },
          "metadata": { "type": "object", "additionalProperties": true },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Artifact": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "subject_ref", "version", "checksum", "content", "created_at"],
        "properties": {
          "artifact_id": { "type": "string", "format": "uuid" },
          "kind": { "const": "tailored_cv" },
          "subject_ref": { "type": "string" },
          "version": { "type": "integer", "minimum": 1 },
          "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "content": { "type": "object", "additionalProperties": true },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Deletion": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deletion_id", "subject_ref", "status", "removed", "error", "completed_at", "created_at"],
        "properties": {
          "deletion_id": { "type": "string", "format": "uuid" },
          "subject_ref": { "type": "string" },
          "status": { "enum": ["queued", "running", "completed", "failed"] },
          "removed": { "type": "object", "additionalProperties": true },
          "error": { "type": ["object", "null"] },
          "completed_at": { "type": ["string", "null"], "format": "date-time" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed or invalid input",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "Unauthorized": {
        "description": "Missing, invalid or revoked credential",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "Forbidden": {
        "description": "Scope or candidate grant denied",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "NotFound": {
        "description": "Resource not found or owned by another tenant",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "Conflict": {
        "description": "Lifecycle, version or idempotency conflict",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "Expired": {
        "description": "Authorized resource is no longer retained",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "TooLarge": {
        "description": "Request body exceeds 256 KiB",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "RateLimited": {
        "description": "Tenant active-run quota reached; Retry-After is set",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "Unavailable": {
        "description": "Operation is not implemented; nothing was queued",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      }
    }
  },
  "paths": {
    "/v1/health": {
      "get": {
        "tags": ["System"],
        "summary": "Sanitised readiness",
        "security": [],
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Envelope" },
                    {
                      "type": "object",
                      "properties": { "data": { "$ref": "#/components/schemas/Health" } }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "tags": ["System"],
        "summary": "This contract",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "tags": ["System"],
        "summary": "Implemented capabilities and limits",
        "responses": {
          "200": {
            "description": "Capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Envelope" },
                    {
                      "type": "object",
                      "properties": { "data": { "$ref": "#/components/schemas/Capabilities" } }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/v1/jobs/analyze": {
      "post": {
        "tags": ["Intelligence"],
        "summary": "Queue job extraction and normalization",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["job"],
                "properties": {
                  "job": { "$ref": "#/components/schemas/Job" },
                  "options": { "$ref": "#/components/schemas/Options" }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Durably accepted; poll the run",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Envelope" },
                    {
                      "type": "object",
                      "properties": { "data": { "$ref": "#/components/schemas/Accepted" } }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/matches": {
      "post": {
        "tags": ["Intelligence"],
        "summary": "Assess requirements against authorized candidate facts",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["candidate", "job"],
                "properties": {
                  "candidate": { "$ref": "#/components/schemas/Candidate" },
                  "job": { "$ref": "#/components/schemas/Job" },
                  "options": { "$ref": "#/components/schemas/Options" }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Durably accepted; poll the run",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Envelope" },
                    {
                      "type": "object",
                      "properties": { "data": { "$ref": "#/components/schemas/Accepted" } }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/cv/tailor": {
      "post": {
        "tags": ["Intelligence"],
        "summary": "Queue an immutable extractive CV artifact",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["candidate", "job"],
                "properties": {
                  "candidate": { "$ref": "#/components/schemas/Candidate" },
                  "job": { "$ref": "#/components/schemas/Job" },
                  "options": { "$ref": "#/components/schemas/Options" }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Durably accepted; poll the run",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Envelope" },
                    {
                      "type": "object",
                      "properties": { "data": { "$ref": "#/components/schemas/Accepted" } }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/v1/runs": {
      "post": {
        "tags": ["Runs"],
        "summary": "Create a typed run",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["operation", "job"],
                    "properties": {
                      "operation": { "const": "job_analysis" },
                      "job": { "$ref": "#/components/schemas/Job" },
                      "options": { "$ref": "#/components/schemas/Options" }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["operation", "candidate", "job"],
                    "properties": {
                      "operation": { "enum": ["match", "cv_tailoring"] },
                      "candidate": { "$ref": "#/components/schemas/Candidate" },
                      "job": { "$ref": "#/components/schemas/Job" },
                      "options": { "$ref": "#/components/schemas/Options" }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Durably accepted; poll the run",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Envelope" },
                    {
                      "type": "object",
                      "properties": { "data": { "$ref": "#/components/schemas/Accepted" } }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/v1/runs/{run_id}": {
      "get": {
        "tags": ["Runs"],
        "summary": "Read authoritative run status and result",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Run",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Envelope" },
                    {
                      "type": "object",
                      "properties": { "data": { "$ref": "#/components/schemas/Run" } }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "410": { "$ref": "#/components/responses/Expired" }
        }
      }
    },
    "/v1/runs/{run_id}/events": {
      "get": {
        "tags": ["Runs"],
        "summary": "Read ordered, redacted run events",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "after_sequence",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "Events",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Envelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["events", "next_after_sequence"],
                          "properties": {
                            "events": {
                              "type": "array",
                              "items": { "$ref": "#/components/schemas/RunEvent" }
                            },
                            "next_after_sequence": { "type": "integer" }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "410": { "$ref": "#/components/responses/Expired" }
        }
      }
    },
    "/v1/runs/{run_id}/cancel": {
      "post": {
        "tags": ["Runs"],
        "summary": "Cancel a run with a version check",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["expected_version"],
                "properties": { "expected_version": { "type": "integer", "minimum": 1 } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cancellation accepted",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Envelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["cancelled", "effective"],
                          "properties": {
                            "cancelled": { "const": true },
                            "effective": { "enum": ["immediate", "at_safe_boundary"] }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "410": { "$ref": "#/components/responses/Expired" }
        }
      }
