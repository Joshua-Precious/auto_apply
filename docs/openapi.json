{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Job Automation Service",
    "version": "0.2.0",
    "description": "LIVE CONTRACT, MILESTONE 2. Implemented: health, capabilities, asynchronous job analysis and matching, run status, ordered run events, and cancellation. CV tailoring, artifacts, approval/resume, deletion and webhooks are documented but disabled and fail closed with 422 FEATURE_DISABLED. All work is durable in PostgreSQL and executed by a separate worker; no long-running work happens inside a request. BYOK scoped client keys only, no console sessions. Private responses are Cache-Control private, no-store. Credential-derived tenant and candidate grants apply to every private resource. Unknown properties rejected. IDs are service UUIDs, never platform database models."
  },
  "servers": [{"url": "http://localhost:3000", "description": "Local development origin (configured by APP_ORIGIN)"}],
  "security": [{"clientKey": []}, {"consoleSession": []}],
  "tags": [{"name":"System"},{"name":"Intelligence"},{"name":"Runs"},{"name":"Artifacts"},{"name":"Privacy"},{"name":"Webhooks"}],
  "x-common-policy": {
    "authentication": "Active scoped client key or authenticated console subject with equivalent permission and explicit tenant/candidate grant; no caller-controlled tenant ID. Console mutations require CSRF token and validated Origin.",
    "body_limit_bytes": 262144,
    "rate_limits": {"read_per_client_per_minute":120,"mutation_per_client_per_minute":20,"run_creation_per_client_per_minute":10,"health_per_ip_per_minute":60},
    "quotas": {"active_intelligence_per_tenant":2,"active_browser_per_tenant":1},
    "idempotency": "Run creation requires Idempotency-Key (8-128 characters). Key unique within tenant/client for 24h. Hash validated normalized operation/input/options, independent of alias route; same key+hash returns original 202 response and Location, changed hash returns 409. Queue dedup alone is insufficient. No guarantee of exactly-once external effects.",
    "retention": "Input/result/artifacts: proposed 30 days; redacted audit: 90 days; idempotency: 24h; diagnostic capture off by default, <=24h. Expiration enforced by purge worker. Unauthorized IDs return 404.",
    "errors": "Every error uses ErrorEnvelope, including proxy size/rate failures. 400 malformed/schema input; 401 missing/invalid/revoked credential; 403 scope/candidate authority denied; 404 inaccessible/not found; 409 lifecycle/version/idempotency conflict; 410 authorized expired resource; 413 size; 422 unsupported semantics; 429 limits; 503 dependency unavailable.",
    "console_auth": "Cequre console auth transport/routes verified in M1. HttpOnly Secure same-origin session; no service keys in frontend. Cookie scheme is a design placeholder pending runtime verification. Public developer registration disabled."
  },
  "paths": {
    "/v1/health": {
      "get": {
        "operationId":"getHealth","tags":["System"],"summary":"Sanitized readiness","security":[],
        "x-policy":{"permissions":[],"execution":"synchronous","rate_class":"public_health","idempotency":"Safe GET","state_transitions":[],"retention":"No candidate data","availability":"implemented (M1)"},
        "responses": {
          "200":{"description":"Ready; no infrastructure details","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Health"},"example":{"status":"ok"}}}},
          "503":{"description":"Not ready; sanitized","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Health"},"example":{"status":"unavailable"}}}},
          "429":{"$ref":"#/components/responses/RateLimited"}
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId":"getCapabilities","tags":["System"],"summary":"Report implemented capabilities and limits, not planned promises",
        "x-policy":{"permissions":["capabilities:read"],"execution":"synchronous","rate_class":"read","idempotency":"Safe GET","state_transitions":[],"retention":"No candidate content","availability":"implemented (M1)"},
        "responses":{"200":{"description":"Capability flags; example is deterministic mode only","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CapabilitiesEnvelope"},"example":{"data":{"schema_version":"v1","inference_mode":"deterministic","features":{"job_analysis":true,"match":true,"cv_tailoring":false,"application_prepare":false,"submission":false,"webhooks":false},"supported_targets":[],"max_body_bytes":262144,"max_job_characters":30000,"max_candidate_facts":200},"request_id":"949f3dc1-fef3-4e38-af7c-eb048f269724"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"},"503":{"$ref":"#/components/responses/Unavailable"}}
      }
    },
    "/v1/jobs/analyze": {
      "post": {
        "operationId":"analyzeJob","tags":["Intelligence"],"summary":"Queue job extraction and normalization",
        "description":"Text-only input initially; URL extraction is not enabled until restricted supported-target workflow exists. All AI work is outside the HTTP lifecycle.",
        "parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],
        "x-policy":{"permissions":["jobs:analyze","runs:write"],"execution":"asynchronous","rate_class":"run_creation","idempotency":"Required key; see common policy","state_transitions":["new -> queued"],"retention":"30-day job input/result; 90-day redacted run audit","availability":"implemented (M2)"},
        "requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AnalyzeRequest"},"example":{"job":{"kind":"text","text":"Example Ltd seeks a backend engineer with TypeScript and API testing experience."},"options":{"locale":"en","timeout_seconds":300}}}}},
        "responses":{"202":{"$ref":"#/components/responses/RunAccepted"},"400":{"$ref":"#/components/responses/InvalidInput"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"409":{"$ref":"#/components/responses/Conflict"},"413":{"$ref":"#/components/responses/TooLarge"},"422":{"$ref":"#/components/responses/Unsupported"},"429":{"$ref":"#/components/responses/RateLimited"},"503":{"$ref":"#/components/responses/Unavailable"}}
      }
    },
    "/v1/matches": {
      "post": {
        "operationId":"createMatch","tags":["Intelligence"],"summary":"Queue explainable candidate-job assessment",
        "description":"Consent purpose must be job_matching. Returns evidence, missing information and limitations; no hiring probability. Candidate grant checked independently of supplied subject_ref.",
        "parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],
        "x-policy":{"permissions":["matches:write","runs:write"],"execution":"asynchronous","rate_class":"run_creation","idempotency":"Required key; see common policy","state_transitions":["new -> queued"],"retention":"30-day snapshots/results; 90-day redacted audit","availability":"implemented (M2)"},
        "requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CandidateJobRequest"}}}},
        "responses":{"202":{"$ref":"#/components/responses/RunAccepted"},"400":{"$ref":"#/components/responses/InvalidInput"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"409":{"$ref":"#/components/responses/Conflict"},"413":{"$ref":"#/components/responses/TooLarge"},"422":{"$ref":"#/components/responses/Unsupported"},"429":{"$ref":"#/components/responses/RateLimited"},"503":{"$ref":"#/components/responses/Unavailable"}}
      }
    },
    "/v1/cv/tailor": {
      "post": {
        "operationId":"tailorCv","tags":["Intelligence"],"summary":"Queue a separate grounded structured CV artifact",
        "description":"Consent purpose cv_tailoring. Initial extractive mode reorders supplied facts only; phrasing suggestions separate and unverified. Original CV unchanged. Scope and candidate grant required.",
        "parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],
        "x-policy":{"permissions":["cv:tailor","runs:write"],"execution":"asynchronous","rate_class":"run_creation","idempotency":"Required key; see common policy","state_transitions":["new -> queued"],"retention":"30-day input and immutable versioned artifact","availability":"implemented (M3)"},
        "requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CandidateJobRequest"},"example":{"candidate":{"subject_ref":"candidate-42","consent":{"purpose":"cv_tailoring","granted_at":"2026-10-10T12:00:00Z"},"facts":[{"id":"fact-1","kind":"summary","text":"Backend engineer with TypeScript experience."},{"id":"fact-2","kind":"skill","text":"TypeScript"},{"id":"fact-3","kind":"experience","text":"Built API endpoints and automated tests at Example Ltd.","employer":"Example Ltd","title":"Software Engineer"}],"preferences":{"preparation_only":true}},"job":{"kind":"text","text":"Example Ltd seeks a backend engineer with TypeScript and API testing experience."},"options":{"locale":"en","timeout_seconds":300}}}}},
        "responses":{"202":{"$ref":"#/components/responses/RunAccepted"},"400":{"$ref":"#/components/responses/InvalidInput"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"409":{"$ref":"#/components/responses/Conflict"},"413":{"$ref":"#/components/responses/TooLarge"},"422":{"$ref":"#/components/responses/Unsupported"},"429":{"$ref":"#/components/responses/RateLimited"},"503":{"$ref":"#/components/responses/Unavailable"}}
      }
    },
    "/v1/runs": {
      "post": {
        "operationId":"createRun","tags":["Runs"],"summary":"Create a bounded typed task",
        "description":"Operation-specific scope also required. Consent must match operation. Unsupported/disabled tasks return 422. No raw browser prompt, code, arbitrary URL, credential, model or token-limit override. application_prepare is owned-test-target only when enabled; candidate preferences preparation_only=true cannot be overridden.",
        "parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],
        "x-policy":{"permissions":["runs:write","operation-specific scope"],"execution":"asynchronous","rate_class":"run_creation","idempotency":"Required key; aliases canonicalize before hashing","state_transitions":["new -> queued"],"retention":"30-day inputs/results; 90-day redacted audit","availability":"implemented for job_analysis and match (M2); application_prepare M4"},
        "requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateRunRequest"},"example":{"operation":"job_analysis","job":{"kind":"text","text":"Example Ltd seeks a backend engineer with TypeScript and API testing experience."},"options":{"locale":"en","timeout_seconds":300}}}}},
        "responses":{"202":{"$ref":"#/components/responses/RunAccepted"},"400":{"$ref":"#/components/responses/InvalidInput"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"409":{"$ref":"#/components/responses/Conflict"},"413":{"$ref":"#/components/responses/TooLarge"},"422":{"$ref":"#/components/responses/Unsupported"},"429":{"$ref":"#/components/responses/RateLimited"},"503":{"$ref":"#/components/responses/Unavailable"}}
      }
    },
    "/v1/runs/{run_id}": {
      "parameters":[{"$ref":"#/components/parameters/RunId"}],
      "get": {
        "operationId":"getRun","tags":["Runs"],"summary":"Retrieve authoritative execution status and validated result",
        "x-policy":{"permissions":["runs:read"],"execution":"synchronous","rate_class":"read","idempotency":"Safe GET","state_transitions":[],"retention":"Expired input/result unavailable; redacted audit may remain","availability":"implemented (M2)"},
        "responses":{"200":{"description":"Run; result null until available; submitted only with evidence","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RunEnvelope"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"410":{"$ref":"#/components/responses/Gone"},"429":{"$ref":"#/components/responses/RateLimited"},"503":{"$ref":"#/components/responses/Unavailable"}}
      }
    },
    "/v1/runs/{run_id}/events": {
      "parameters":[{"$ref":"#/components/parameters/RunId"}],
      "get": {
        "operationId":"listRunEvents","tags":["Runs"],"summary":"Read ordered redacted event history",
        "parameters":[{"name":"after_sequence","in":"query","schema":{"type":"integer","minimum":0,"default":0}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":50}}],
        "x-policy":{"permissions":["runs:read"],"execution":"synchronous","rate_class":"read","idempotency":"Safe GET","state_transitions":[],"retention":"90-day redacted metadata only; no prompts/page content/CV fields","availability":"implemented (M2)"},
        "responses":{"200":{"description":"Increasing per-run sequences; next_after_sequence is last returned, or supplied cursor if empty","content":{"application/json":{"schema":{"$ref":"#/components/schemas/EventsEnvelope"}}}},"400":{"$ref":"#/components/responses/InvalidInput"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"410":{"$ref":"#/components/responses/Gone"},"429":{"$ref":"#/components/responses/RateLimited"},"503":{"$ref":"#/components/responses/Unavailable"}}
      }
    },
    "/v1/runs/{run_id}/cancel": {
      "parameters":[{"$ref":"#/components/parameters/RunId"}],
      "post": {
        "operationId":"cancelRun","tags":["Runs"],"summary":"Persist a cancellation request; not an external rollback",
        "description":"Duplicate pending cancel is a no-op returning current status. Already cancelled returns current status. Other terminal states return 409. Worker confirms safe termination; unresolved submission may produce partially_completed/unknown rather than cancelled.",
        "x-policy":{"permissions":["runs:control"],"execution":"asynchronous control","rate_class":"mutation","idempotency":"State/version-aware no-op for same pending cancellation; no creation key","state_transitions":["nonterminal -> cancel requested","safe cleanup -> cancelled","uncertain side effect -> partially_completed"],"retention":"90-day redacted control event","availability":"implemented (M2)"},
        "requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/VersionRequest"},"example":{"expected_version":3}}}},
        "responses":{"202":{"description":"Cancellation accepted or already requested; status is truthful current state","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RunEnvelope"}}}},"400":{"$ref":"#/components/responses/InvalidInput"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/Conflict"},"410":{"$ref":"#/components/responses/Gone"},"429":{"$ref":"#/components/responses/RateLimited"},"503":{"$ref":"#/components/responses/Unavailable"}}
      }
    },
    "/v1/runs/{run_id}/approve": {
      "parameters":[{"$ref":"#/components/parameters/RunId"}],
      "post": {
        "operationId":"approveRun","tags":["Runs"],"summary":"Record candidate-authorized approval of exact immutable draft",
        "description":"Only awaiting_approval. API scope alone is insufficient: bound console candidate identity or registered first-party signed assertion required. Verify issuer/audience/subject/JTI/expiry/run/hash/version. A boolean or arbitrary actor string cannot authorize. Does not dispatch. Same actor/exact still-active approval may return existing record; proof replay for any other binding rejected. Material changes invalidate approval.",
        "x-policy":{"permissions":["runs:approve","candidate submission authority"],"execution":"synchronous control","rate_class":"mutation","idempotency":"Unique proof JTI and draft binding; state/version CAS; replay rejected","state_transitions":["awaiting_approval -> awaiting_approval (approval recorded)"],"retention":"90-day redacted proof metadata, no raw assertion","availability":"M5 test-only"},
        "requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApprovalRequest"}}}},
        "responses":{"200":{"description":"Approval stored; explicit resume required","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApprovalEnvelope"}}}},"400":{"$ref":"#/components/responses/InvalidInput"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/Conflict"},"410":{"$ref":"#/components/responses/Gone"},"422":{"$ref":"#/components/responses/Unsupported"},"429":{"$ref":"#/components/responses/RateLimited"},"503":{"$ref":"#/components/responses/Unavailable"}}
      }
    },
    "/v1/runs/{run_id}/resume": {
      "parameters":[{"$ref":"#/components/parameters/RunId"}],
      "post": {
        "operationId":"resumeRun","tags":["Runs"],"summary":"Dispatch an authorized typed continuation",
        "description":"Only awaiting_approval with valid approval, or awaiting_user_action with an acknowledged supported intervention. No arbitrary browser instruction or cookie upload. Expired browser state must be recreated and revalidated; candidate changes require new draft approval. Same continuation duplicate cannot create a second dispatch; invalid expected version/state returns 409.",
        "x-policy":{"permissions":["runs:control","candidate authority when submission requested"],"execution":"asynchronous control","rate_class":"mutation","idempotency":"CAS state/version + unique dispatch + one-use approval; no submission retry after intent","state_transitions":["awaiting_approval -> queued","awaiting_user_action -> queued"],"retention":"90-day redacted continuation event","availability":"M4 interventions; M5 approval resume"},
        "requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ResumeRequest"}}}},
        "responses":{"202":{"description":"Queued continuation","content":{"application/json":{"schema":{"$ref":"#/components/schemas/RunAcceptedEnvelope"}}}},"400":{"$ref":"#/components/responses/InvalidInput"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/Conflict"},"410":{"$ref":"#/components/responses/Gone"},"422":{"$ref":"#/components/responses/Unsupported"},"429":{"$ref":"#/components/responses/RateLimited"},"503":{"$ref":"#/components/responses/Unavailable"}}
      }
    },
    "/v1/artifacts/{artifact_id}": {
      "get": {
        "operationId":"getArtifact","tags":["Artifacts"],"summary":"Retrieve authorized immutable artifact version",
        "parameters":[{"name":"artifact_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],
        "x-policy":{"permissions":["artifacts:read"],"execution":"synchronous","rate_class":"read","idempotency":"Safe GET","state_transitions":[],"retention":"30-day structured artifacts; signed URLs <=60s when enabled; diagnostics <=24h","availability":"implemented (M3) for structured CV; other kinds M4+"},
        "responses":{"200":{"description":"Structured private content; URL null until binary storage enabled","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ArtifactEnvelope"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"410":{"$ref":"#/components/responses/Gone"},"429":{"$ref":"#/components/responses/RateLimited"},"503":{"$ref":"#/components/responses/Unavailable"}}
      }
    },
    "/v1/candidates/{subject_ref}/data": {
      "delete": {
        "operationId":"deleteCandidateData","tags":["Privacy"],"summary":"Request authorized deletion and fence candidate executions",
        "description":"Remove snapshots, derived artifacts and sensitive results; cancel/fence active work first. External actions not reversible. Backup purge/restore deletion replay documented. Duplicate active request returns existing deletion ID. Candidate authority checked separately from client scope.",
        "parameters":[{"name":"subject_ref","in":"path","required":true,"schema":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9._-]+$"}}],
        "x-policy":{"permissions":["data:delete","candidate data authority"],"execution":"asynchronous","rate_class":"mutation","idempotency":"Coalesce active tenant/subject deletion request","state_transitions":["deletion queued -> running -> completed or failed"],"retention":"Purge candidate content; retain minimal expiring pseudonymous deletion ledger for backup restore","availability":"implemented (M3)"},
        "responses":{"202":{"description":"Deletion accepted; poll status","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeletionEnvelope"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"409":{"$ref":"#/components/responses/Conflict"},"429":{"$ref":"#/components/responses/RateLimited"},"503":{"$ref":"#/components/responses/Unavailable"}}
      }
    },
    "/v1/deletions/{deletion_id}": {
      "get": {
        "operationId":"getDeletion","tags":["Privacy"],"summary":"Check deletion outcome",
        "parameters":[{"name":"deletion_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],
        "x-policy":{"permissions":["data:delete","candidate data authority"],"execution":"synchronous","rate_class":"read","idempotency":"Safe GET","state_transitions":[],"retention":"Minimal deletion ledger; no CV content","availability":"implemented (M3)"},
        "responses":{"200":{"description":"Deletion status","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DeletionEnvelope"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"404":{"$ref":"#/components/responses/NotFound"},"429":{"$ref":"#/components/responses/RateLimited"},"503":{"$ref":"#/components/responses/Unavailable"}}
      }
    },
    "/v1/webhooks": {
      "post": {
        "operationId":"registerWebhook","tags":["Webhooks"],"summary":"Future signed webhook registration (disabled initially)",
        "description":"Future contract: restricted HTTPS only, DNS/egress validation at registration and each delivery; no redirects. No browser data or result payload in event. Secret returned once, stored encrypted with deployment key for signing (hash alone cannot sign). Management/rotation/delivery-history contract refined before enabling. Initial versions return 422 FEATURE_DISABLED.",
        "x-policy":{"permissions":["webhooks:write"],"execution":"synchronous registration; async delivery","rate_class":"mutation","idempotency":"Unique normalized URL+client returns 409 for duplicate; future rotation separate","state_transitions":[],"retention":"Registration until revoked; delivery metadata proposed 30 days","availability":"M6 deferred"},
        "requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebhookRequest"}}}},
        "responses":{"201":{"description":"Future enabled behavior only: secret once","content":{"application/json":{"schema":{"$ref":"#/components/schemas/WebhookEnvelope"}}}},"400":{"$ref":"#/components/responses/InvalidInput"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"409":{"$ref":"#/components/responses/Conflict"},"413":{"$ref":"#/components/responses/TooLarge"},"422":{"$ref":"#/components/responses/Unsupported"},"429":{"$ref":"#/components/responses/RateLimited"},"503":{"$ref":"#/components/responses/Unavailable"}}
      }
    }
  },
  "components": {
    "securitySchemes": {
      "clientKey":{"type":"http","scheme":"bearer","bearerFormat":"ja_live_<key-id>.<256-bit-secret>","description":"Server-to-server scoped API secret. Hash only persisted, display at provisioning once. Active status and candidate grants checked per request."},
      "consoleSession":{"type":"apiKey","in":"cookie","name":"cequre_auth","description":"Proposed authenticated console session, pending M1 runtime verification. Same-origin CSRF and membership/candidate authorization required; not a privileged client API key."}
    },
    "parameters": {
      "IdempotencyKey":{"name":"Idempotency-Key","in":"header","required":true,"description":"24h tenant/client dedup; changed canonical input under same key is 409","schema":{"type":"string","minLength":8,"maxLength":128,"pattern":"^[A-Za-z0-9._-]+$"},"example":"tailor-candidate42-job17-v1"},
      "RunId":{"name":"run_id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}
    },
    "responses": {
      "RunAccepted":{"description":"Durably accepted; no browser/AI execution inside request","headers":{"Location":{"description":"Authoritative status path","schema":{"type":"string"}},"Idempotency-Replayed":{"description":"true for duplicate accepted request","schema":{"type":"boolean"}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/RunAcceptedEnvelope"},"example":{"data":{"run_id":"c0db54c8-3dde-4ab8-95ed-3a1c1ed3d0b1","status":"queued","status_url":"/v1/runs/c0db54c8-3dde-4ab8-95ed-3a1c1ed3d0b1","created_at":"2026-10-10T12:00:01Z"},"request_id":"949f3dc1-fef3-4e38-af7c-eb048f269724"}}}},
      "InvalidInput":{"description":"400 invalid schema/malformed input","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},
      "Unauthorized":{"description":"401 missing/invalid/revoked credential","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},
      "Forbidden":{"description":"403 scope or candidate authority denied","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},
      "NotFound":{"description":"404 unknown or inaccessible tenant/subject resource","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},
      "Conflict":{"description":"409 idempotency/state/version/approval conflict","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"},"example":{"error":{"code":"IDEMPOTENCY_CONFLICT","message":"This idempotency key was used for a different request.","retryable":false,"details":[]},"request_id":"949f3dc1-fef3-4e38-af7c-eb048f269724"}}}},
      "Gone":{"description":"410 expired resource, only disclosed after authorization","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},
      "TooLarge":{"description":"413 request exceeds byte limit","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},
      "Unsupported":{"description":"422 unsupported operation/target, consent mismatch or disabled feature","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},
      "RateLimited":{"description":"429 rate or active-resource quota exceeded","headers":{"Retry-After":{"schema":{"type":"integer","minimum":1}}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}},
      "Unavailable":{"description":"503 unavailable durable acceptance/dependency; retry with same idempotency key if outcome uncertain","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}
    },
    "schemas": {
      "Health":{"type":"object","additionalProperties":false,"required":["status"],"properties":{"status":{"type":"string","enum":["ok","unavailable"]}}},
